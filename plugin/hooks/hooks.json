{
  "description": "Lidless: guard sessions that are in the cloud or moving; tell a resumed session where it has been; after each turn, send what changed in the session to your bucket (lidless presync off stops it)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" guard",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" sync --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}