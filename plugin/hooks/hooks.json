{
  "description": "Lidless: stop prompts to a session that is in your cloud sandbox; tell a resumed session where it has been",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" session-start"
          }
        ]
      }
    ]
  }
}